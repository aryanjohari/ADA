# Greenfield profile template — copy to your profile data dir as .env
# Example: $ADA_PROFILE_DATA_ROOT/jarvis/.env
#
# See docs/GREENFIELD_PROFILE.md

# --- Profile (required for isolation) ---
ADA_PROFILE=jarvis
# ADA_PROFILE_DATA_ROOT=/absolute/path/to/ada-profiles
ADA_REQUIRE_PROFILE_ISOLATION=1

# --- Secrets ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# --- Job plane (greenfield: system_jobs only) ---
ADA_JOB_QUEUE=system_jobs

# --- Chat defaults ---
# Plain `ada chat` is Entity (global concierge). This pre-fills Work chat / HUD only:
ADA_CHAT_DEFAULT_MISSION=ada_ops
# Optional HUD sidebar filter (ada hud sets from ADA_CHAT_DEFAULT_MISSION):
# ADA_OPERATOR_DEFAULT_MISSION=ada_ops

# --- Tool toggles (adjust to taste) ---
ADA_ENABLE_MEMORY_TOOLS=1
ADA_ENABLE_KNOWLEDGE_TOOLS=0
ADA_ENABLE_WEB_TOOLS=0
ADA_ENABLE_WORKFLOW_TOOLS=0
ADA_ENABLE_FILE_TOOLS=0

# --- Caps ---
# ADA_MAX_TOOL_ROUNDS=12
# ADA_DAILY_TOKEN_BUDGET=
# ADA_KILL_SWITCH=0

# Programme knobs belong in missions.defaults_json — NOT here.
# Do not set programme env vars (e.g. GSC site URL, project/campaign ids, matrix caps).
# Migrate with: ada mission migrate-env ada_ops --apply
