# Copy to .env and fill in. Never commit .env.

GEMINI_API_KEY=
# Cost-efficient default (2.5 Flash-Lite). Override with e.g. gemini-2.5-flash from:
# https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional: where SQLite and runtime files live (default: <project>/data)
# ADA_DATA_DIR=/path/to/data
# Profile isolation (recommended for client-safe orchestration):
# ADA_PROFILE=client_acme
# ADA_PROFILE_DATA_ROOT=/absolute/path/to/ada-profiles
# Per-tenant memory (default in profile mode: same as profile data_dir; else <repo>/memory):
# ADA_MEMORY_DIR=
# Directory containing default.yaml (default: <profile_data_dir>/policies if that file exists, else <repo>/policies):
# ADA_POLICY_ROOT=
# Enforce profile env contract at startup (1 = required, fail-fast):
# ADA_REQUIRE_PROFILE_ISOLATION=0

# Max model legs per user turn (tool follow-ups included). Default 12.
# ADA_MAX_TOOL_ROUNDS=12

# Hard cap on summed usage_ledger tokens (input+output) per task/session; turns abort when exceeded.
# ADA_MAX_SESSION_TOKENS=50000

# Phase 0 — ada daemon only: stop dequeuing goals (pending stays pending). ada goal add still works.
# ADA_KILL_SWITCH=0

# When programme-shaped deprecated env vars are still set, stderr hints print on Settings.load().
# Set to 1 only after you accept env-as-global fallback (see docs/operator-onboarding.md).
# ADA_DEPRECATED_ENV_SUPPRESS=0

# Optional global caps across all sessions (UTC calendar day / month), summed from usage_ledger. Unset = no limit.
# ADA_DAILY_TOKEN_BUDGET=
# ADA_MONTHLY_TOKEN_BUDGET=

# Optional: use this directory as ADA_DATA_DIR for an isolated DB profile (default: unset = project data/).
# ADA_COMMERCIAL_DATA_DIR=
# Do not set ADA_COMMERCIAL_DATA_DIR together with ADA_PROFILE/ADA_PROFILE_DATA_ROOT.

# Reserved for Phase 3 workflow child-step limits (parsed; not enforced yet).
# ADA_MAX_TASK_STEPS=
# Phase 3: enqueue_workflow + get_workflow_status tools (chat/daemon). Requires knowledge tools for EXTRACT/SYNTHESIZE steps when running workflow-backed goals.
# ADA_ENABLE_WORKFLOW_TOOLS=0

# Allowlisted shell output cap and timeout (seconds).
# ADA_SHELL_MAX_OUTPUT_BYTES=65536
# ADA_SHELL_TIMEOUT_SEC=60

# Stream watchdogs (0 = disable that limit).
# ADA_STREAM_CHUNK_IDLE_SEC=120
# ADA_STREAM_LEG_MAX_SEC=600

# Verbose per-chunk Gemini stream diagnostics on stderr (1=yes). Use when debugging empty legs / tool calls.
# ADA_DEBUG_STREAM=0

# Reparent live rows whose parent was tombstoned (1=yes, 0=no).
# ADA_REWIRE_AFTER_TOMBSTONE=1

# Task clipboard: read_task_plan / write_task_plan (tasks.plan_json). Chat + daemon.
# ADA_ENABLE_PLAN_TOOLS=1

# Cross-session: read_goal_task_view — read another goal task's outcome from SQLite (chat + daemon).
# ADA_ENABLE_GOAL_RECALL_TOOL=1

# Sandboxed workspace files (list_workspace_directory / read / write). Off by default.
# Paths must resolve under ADA_FILE_SANDBOX_ROOTS (comma-separated); empty = project root only.
# Default deny prefixes always include ADA_DATA_DIR and memory/; the project tree is also denied
# when the sandbox root is a parent of the ADA repo (e.g. home-wide roots). Basenames .env, id_rsa, *.pem are denied.
# ADA_ENABLE_FILE_TOOLS=1
# ADA_FILE_SANDBOX_ROOTS=
# ADA_FILE_MAX_READ_BYTES=524288
# ADA_FILE_MAX_WRITE_BYTES=262144
# ADA_FILE_MAX_LIST_ENTRIES=200
# Extra denied path prefixes (comma-separated). Example for SSH: /home/you/.ssh
# ADA_FILE_DENY_PREFIXES=
# Optional file: one absolute path per line, # comments (like shell_allowlist.txt). Relative paths are under project root.
# ADA_FILE_DENYLIST_FILE=
# Extra forbidden basenames (comma-separated), in addition to .env / id_rsa / *.pem.
# ADA_FILE_DENY_BASENAMES=
# Log denied file-tool paths to action_log as file_access_denied (1=yes, 0=no). Default 1.
# ADA_FILE_AUDIT_DENIALS=1

# Memory tools in chat (append_master_section / append_soul_fragment). Dream job: `ada dream`.
# ADA_ENABLE_MEMORY_TOOLS=1
# ADA_MEMORY_MAX_APPEND_BYTES=8192
# ADA_MEMORY_MAX_FILE_BYTES=524288
# ADA_DREAM_MAX_SOUL_BYTES=1024
# ADA_DREAM_MAX_MESSAGES=60

# Web tools (web_search via Serper, fetch_url_text via Jina Reader or httpx). Off by default (cost).
# ADA_ENABLE_WEB_TOOLS=0
# ADA_SERPER_API_KEY=  (or SERPER_API_KEY)
# Live workflow ENRICH (Serper + Jina + graph tools): max tool rounds for that step (default: same as ADA_MAX_TOOL_ROUNDS).
# ADA_ENRICH_MAX_TOOL_ROUNDS=12
# ADA_WEB_SEARCH_MAX_RESULTS=10
# ADA_WEB_SEARCH_TIMEOUT_SEC=30
# ADA_WEB_FETCH_MODE=jina
# ADA_WEB_FETCH_MAX_URLS=3
# ADA_WEB_FETCH_MAX_CHARS=65536
# ADA_WEB_FETCH_MAX_BYTES=524288
# ADA_WEB_FETCH_TIMEOUT_SEC=45
# Optional: comma-separated host glob patterns (e.g. *.python.org,github.com)
# ADA_WEB_FETCH_HOST_ALLOWLIST=
# ADA_JINA_READER_URL=https://r.jina.ai/
# JINA_READER_BASE_URL=https://r.jina.ai/
# ADA_JINA_API_KEY=

# Read-only: list web_sources rows for current session (Phase B). Off by default.
# ADA_ENABLE_WEB_SOURCES_TOOL=0

# Knowledge layer: search_knowledge, record_synthesis, add_knowledge_source (Gemini tools). Off by default in code; set 1 for operator-ready chat/daemon.
# ADA_ENABLE_KNOWLEDGE_TOOLS=1
# Optional: comma-separated hostnames allowed for add_knowledge_source (empty = any https/http host).
# ADA_KNOWLEDGE_FEED_HOST_ALLOWLIST=
# Tool payload caps to reduce token bleed in chat/daemon responses.
# ADA_KNOWLEDGE_TOOL_MAX_RESULTS=8
# ADA_KNOWLEDGE_TOOL_EXCERPT_CHARS=1200

# Register an RSS URL in SQLite, then fetch with ingest-rss:
#   ada add-rss-source https://example.com/feed.xml --label "My feed"
# Offline RSS ingest (`ada ingest-rss`): fetch feeds listed in knowledge_sources (kind=rss).
# ADA_INGEST_RSS_MAX_ITEMS=50
# ADA_INGEST_RSS_MAX_RESPONSE_BYTES=2000000
# ADA_INGEST_RSS_TIMEOUT_SEC=45
# Bounded brand ingest (`ada ingest-brand`): homepage + key internal pages only.
# DEPRECATED: prefer mission.defaults_json.brand_site_url — docs/operator-onboarding.md
# ADA_BRAND_SITE_URL=https://example.com/
# ADA_BRAND_INGEST_MAX_URLS=8
# ADA_BRAND_INGEST_TIMEOUT_SEC=30
# ADA_BRAND_INGEST_MAX_RESPONSE_BYTES=1500000

# Per-item expiry: set N>0 so new ingested rows get expires_at = now + N days (ISO UTC).
# ADA_KNOWLEDGE_DEFAULT_RETENTION_DAYS=

# `ada triage`: score + primary/secondary triage categories for unscored rows (JSON). Requires GEMINI_API_KEY.
# Use `ada triage --backfill-categories` to fill categories on rows that already have impact_score.
# ADA_TRIAGE_MODEL=gemini-2.5-flash-lite
# ADA_TRIAGE_BATCH_SIZE=20
# Enqueue a daemon goal when impact_score >= this (1–10; default 6).
# ADA_TRIAGE_DEEP_DIVE_MIN_SCORE=6
# Daily cap for Tier-2 lead goals (score 6-7). 0 disables Tier-2 enqueues.
# DEPRECATED: prefer mission.defaults_json.triage_lead_daily_cap — docs/operator-onboarding.md
# ADA_TRIAGE_LEAD_DAILY_CAP=10

# Optional LLM gate during ingest (title+summary only, JSON). Requires GEMINI_API_KEY when enabled.
# ADA_INGEST_GATEKEEPER=0
# ADA_INGEST_GATE_MODEL=gemini-2.5-flash-lite
# ADA_INGEST_GATE_MAX_OUTPUT_TOKENS=512

# Gemini embeddings for semantic/hybrid search (optional; uses GEMINI_API_KEY). Ingest writes vectors when enabled.
# ADA_KNOWLEDGE_EMBEDDINGS=0
# ADA_KNOWLEDGE_EMBEDDING_MODEL=gemini-embedding-001
# ADA_KNOWLEDGE_EMBEDDING_DIM=768
# ADA_KNOWLEDGE_EMBEDDING_MIN_COSINE=0.25

# --- Phase 1: deterministic ingest (RSS allowlist, DataForSEO keywords, GETS public index) ---
# Optional: cap how many knowledge_sources (rss) rows are processed per `ada ingest-rss` run (unset = all).
# ADA_INGEST_RSS_MAX_FEEDS=
# DataForSEO Keywords Data API (Google Ads search volume). Basic auth via DATAFORSEO_LOGIN + DATAFORSEO_PASSWORD.
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=
# DEPRECATED: prefer mission.defaults_json.keyword_max_terms_per_run — docs/operator-onboarding.md
# ADA_KEYWORD_MAX_TERMS_PER_RUN=100
# Google Ads location_code for NZ (default 2004); confirm via GET /v3/keywords_data/google_ads/locations .
# DEPRECATED: prefer mission.defaults_json.keyword_location_code — docs/operator-onboarding.md
# ADA_KEYWORD_LOCATION_CODE=2004
# DEPRECATED: prefer mission.defaults_json.keyword_language_code — docs/operator-onboarding.md
# ADA_KEYWORD_LANGUAGE_CODE=en
# Comma-separated seed terms for `ada ingest-keywords` (truncated to ADA_KEYWORD_MAX_TERMS_PER_RUN).
# DEPRECATED: prefer mission.defaults_json.keyword_terms — docs/operator-onboarding.md
# ADA_KEYWORD_TERMS=
# 0 = task_post + task_get (batch); 1 = search_volume/live (lower latency; vendor RPM limits apply).
# ADA_DATAFORSEO_USE_LIVE=0
# Hosts allowed for gov API clients (DataForSEO, GETS). Comma-separated hostnames.
# ADA_GOV_API_HOST_ALLOWLIST=api.dataforseo.com,gets.govt.nz,www.gets.govt.nz
# Public tender index (no RealMe); full documents require login.
# DEPRECATED: prefer mission.defaults_json.gets_poll_url — docs/operator-onboarding.md
# ADA_GETS_POLL_URL=https://www.gets.govt.nz/ExternalIndex.htm

# --- B2B pSEO / S3 publisher (publish_entity_v1: ENRICH → GATE → DRAFT → DEPLOY) ---
# Same bucket name as the Next.js ISR app (Vercel): match S3_BUCKET_NAME on the frontend.
# S3_BUCKET_NAME=
# Optional alias; if set, should equal S3_BUCKET_NAME.
# ADA_S3_BUCKET=
# Optional default bucket for publish delivery mode wordpress_csv_s3 when params omit bucket (separate from ISR bucket).
# ADA_WORDPRESS_CSV_S3_BUCKET=
# AWS_REGION=us-east-1
# For local MinIO / LocalStack only:
# AWS_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# GATE: minimum distinct non-empty source_url on active outgoing graph_edges (see docs/pseo-isr-contract.md).
# DEPRECATED: prefer mission.defaults_json.publish_min_unique_facts — docs/operator-onboarding.md
# ADA_PUBLISH_MIN_UNIQUE_FACTS=3
# DRAFT step model (default: GEMINI_MODEL).
# ADA_PUBLISH_DRAFT_MODEL=gemini-2.5-flash-lite
# publish_entity_v1 supports optional params_json fields:
# target_keyword_cluster="roof repair auckland" (string only; validated)
# keyword_source={"kind":"gsc","site":"https://example.com/","start_date":"2026-01-01","end_date":"2026-01-31"}
# If omitted or invalid, workflow falls back to brand/entity-only mode and logs fallback_reason.
# ENRICH (live): DB-only preflight. Empty ADA_ENRICH_SUFF_MIN_UNIQUE_FACTS = same as ADA_PUBLISH_MIN_UNIQUE_FACTS; 0 = off.
# ADA_ENRICH_SUFF_MIN_UNIQUE_FACTS=
# ADA_ENRICH_SUFF_MIN_OUTGOING_EDGES=0
# ADA_ENRICH_SUFF_MODE=all
# ADA_ENRICH_SUFF_FORCE_WEB=0
# Optional graph+search_knowledge pass when the graph is already sufficient (no Serper/Jina).
# ADA_ENRICH_SUFF_GRAPH_REFINE=0
# DRAFT: top-K knowledge_items search (lexical, or hybrid when ADA_KNOWLEDGE_EMBEDDINGS=1) added to the prompt.
# DRAFT: include bounded subject subgraph JSON + graph-anchored knowledge_items RAG (default on)
# ADA_PUBLISH_DRAFT_GRAPH_ANCHORED=1
# ADA_PUBLISH_DRAFT_SUBGRAPH_MAX_JSON=40000
# ADA_PUBLISH_DRAFT_KNOWLEDGE_RETRIEVAL=0
# ADA_PUBLISH_DRAFT_KNOWLEDGE_TOP_K=8
# ADA_PUBLISH_DRAFT_KNOWLEDGE_MAX_TOTAL_CHARS=12000
# ADA_PUBLISH_DRAFT_KNOWLEDGE_EXCERPT_PER_ITEM=2000
# ADA_PUBLISH_DRAFT_KNOWLEDGE_MIN_COSINE=
# auto | lexical | semantic | hybrid
# ADA_PUBLISH_DRAFT_KNOWLEDGE_SEARCH_MODE=auto
# Matrix (ada matrix-scan): enqueue publish_entity_v1 for entities with category edges.
# ADA_MATRIX_ENABLE=0
# DEPRECATED: prefer mission.defaults_json.matrix_max_enqueues — docs/operator-onboarding.md
# ADA_MATRIX_MAX_ENQUEUES=20
# Comma-separated entity `type` values to scan (default: service,regulation,organization,jurisdiction).
# NZ pSEO phase 1 often uses graph-lite types (lowercase; config lowercases):
# DEPRECATED: prefer mission.defaults_json.matrix_entity_types (JSON array) — docs/operator-onboarding.md
# ADA_MATRIX_ENTITY_TYPES=organization,government_body,policy_instrument
# ADA_MATRIX_ENTITY_TYPES=service,regulation,organization,jurisdiction
# Default ISR placement for matrix (override per run via workflow params on manual enqueue):
# DEPRECATED: prefer mission.defaults_json.project_id — docs/operator-onboarding.md
# ADA_PROJECT_ID=default
# DEPRECATED: prefer mission.defaults_json.campaign_id — docs/operator-onboarding.md
# ADA_CAMPAIGN_ID=main
# Optional: prioritize recent-enriched subjects via LLM (strict JSON → validated entity ids):
# ADA_MATRIX_PLANNER=0
# ADA_MATRIX_PLANNER_MODEL=
# On planner JSON/validation failure, fall back to legacy stable-id matrix scan:
# ADA_MATRIX_PLANNER_LEGACY_FALLBACK=0

# Policy plane (policies/default.yaml); optional overlay file or directory of yaml:
# ADA_POLICY_PACK=
# ADA_INTENT_MAX_BYTES=
# ADA_MATRIX_PLANNER_TOP_K=

# --- Approval gates ---
# Require durable approval record before workflow enqueue:
# ADA_REQUIRE_APPROVAL_FOR_ENQUEUE=0
# Require durable approval record before DEPLOY step:
# ADA_REQUIRE_APPROVAL_FOR_PUBLISH=0

# --- Google Search Console ingestion ---
# Enable gsc CLI ingestion mode:
# ADA_ENABLE_GSC_INGEST=0
# DEPRECATED: prefer mission.defaults_json.gsc_site_url — docs/operator-onboarding.md
# GSC_SITE_URL=https://example.com/
# GSC_AUTH_MODE=service_account_json
# One of:
# GSC_SERVICE_ACCOUNT_JSON=
# GSC_SERVICE_ACCOUNT_FILE=/absolute/path/service-account.json
# GSC_API_BASE_URL=https://www.googleapis.com/webmasters/v3
# ADA_GSC_TIMEOUT_CONNECT_SEC=5
# ADA_GSC_TIMEOUT_READ_SEC=30
# ADA_GSC_TIMEOUT_TOTAL_SEC=120
# ADA_GSC_RETRY_MAX_ATTEMPTS=5
# ADA_GSC_RETRY_BASE_MS=250
# ADA_GSC_RETRY_MAX_MS=8000
# ADA_GSC_PAGE_SIZE=25000
# ADA_GSC_MAX_DAYS_PER_REQUEST=7
# ADA_GSC_MAX_ROWS_PER_RUN=200000
# ADA_GSC_DRY_RUN_DEFAULT=0
# Read-only GSC tool + deterministic campaign plan prefill for ada goal/daemon:
# ADA_ENABLE_GSC_READ_TOOLS=0
# ADA_GSC_PLAN_DEFAULT_LOOKBACK_DAYS=28
# ADA_GSC_PLAN_MAX_ITEMS=25
# Optional helper:
# ada keyword-select --entity-id 123 --site "https://example.com/" --start-date 2026-01-01 --end-date 2026-01-31
