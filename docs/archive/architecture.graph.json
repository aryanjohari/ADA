  "captions": [
    {
      "id": "cli-chat",
      "title": "Operator chats",
      "body": "ada chat runs Entity, Agent, Plan, or Setup ingress on the operator’s machine—no public HTTP API.",
      "spotlightIds": ["cli-chat"]
    },
    {
      "id": "orchestrator",
      "title": "Manual tool loop",
      "body": "The orchestrator streams Gemini legs with automatic function calling off, then persists each tool call itself.",
      "items": [
        "Allowlisted shell and YAML motor skills",
        "Claude-style transcript with parent_uuid"
      ],
      "spotlightIds": ["orchestrator", "tool-executor"]
    },
    {
      "id": "state-db",
      "title": "Local truth",
      "body": "Per-profile SQLite (WAL + FTS5) holds messages, jobs, knowledge, and graph; markdown memory files sit beside it.",
      "spotlightIds": ["state-db", "memory-files"]
    },
    {
      "id": "publish-workflows",
      "title": "Deterministic publish",
      "body": "Entity pages run ENRICH → GATE → DRAFT → DEPLOY; keyword pages skip GATE.",
      "items": [
        "GATE needs distinct HTTPS source_url facts",
        "PageJsonV1 is a strict Pydantic contract"
      ],
      "spotlightIds": ["publish-workflows", "daemon"]
    },
    {
      "id": "s3-out",
      "title": "S3 page.json",
      "body": "DEPLOY writes /{project}/{campaign}/{slug}/page.json and merges manifest.json for an out-of-repo ISR consumer.",
      "spotlightIds": ["s3-out"]
    }
  ]
}
