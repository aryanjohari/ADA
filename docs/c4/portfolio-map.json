{
  "version": 1,
  "defaultLevel": "context",
  "context": { "path": "docs/c4/1-context.mmd" },
  "containers": { "path": "docs/c4/2-containers.mmd" },
  "zoom": [
    {
      "id": "ada",
      "label": "ADA",
