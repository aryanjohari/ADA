    {
      "id": "publish-workflows",
      "label": "Publish workflows",
      "fromLevel": "containers",
      "toLevel": "components",
      "matchLabels": ["Publish workflows", "ENRICH"],
      "componentsPath": "docs/c4/3-components/publish-workflows.mmd"
