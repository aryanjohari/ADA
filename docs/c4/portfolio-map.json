  "componentZooms": [
    {
      "id": "agent-core",
      "label": "Agent core",
      "path": "docs/c4/3-components/agent-core.mmd",
      "markdownPath": "docs/c4/3-components/agent-core.md",
      "coversContainers": ["cli-chat", "orchestrator", "tool-executor"]
    },
    {
      "id": "daemon",
      "label": "ada daemon",
      "path": "docs/c4/3-components/daemon.mmd",
      "markdownPath": "docs/c4/3-components/daemon.md",
      "coversContainers": ["daemon"]
    },
    {
      "id": "ingest-clis",
      "label": "Ingest CLIs",
      "path": "docs/c4/3-components/ingest-clis.mmd",
