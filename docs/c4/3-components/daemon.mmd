C4Component
  title Components — ada daemon

  Container_Boundary(daemon, "ada daemon") {
    Component(worker, "Job worker", "jobs/worker.py / main.py", "Polls configured job plane")
    Component(plane, "Job plane", "ADA_JOB_QUEUE", "legacy goal tasks XOR system_jobs")
    Component(goals, "Goal turns", "daemon_goal.py", "Dequeues goals; may call orchestrator")
    Component(wfRun, "Workflow runner", "workflow/runner.py", "Advances deterministic step kinds")
    Component(templates, "Workflow templates", "workflow/templates.py", "Code-defined WORKFLOW_KINDS only")
    Component(handlers, "system_jobs handlers", "jobs/handlers.py", "workflow.start, ingest.run, matrix, ticks")
  }

  Component_Ext(orch, "Orchestrator", "Shared agent-core turn loop")
  ComponentDb_Ext(stateDb, "state.db", "SQLite")

  Rel(worker, plane, "Owns one plane per state.db")
  Rel(worker, goals, "goal.run_turn / legacy tasks")
  Rel(worker, handlers, "Dispatches system_jobs kinds")
  Rel(worker, wfRun, "workflow.start and step jobs")
  Rel(wfRun, templates, "Resolves kind → steps")
  Rel(goals, orch, "Model turns when needed")
  Rel(worker, stateDb, "Claims / completes jobs")
  Rel(wfRun, stateDb, "Reads/writes workflow state")
