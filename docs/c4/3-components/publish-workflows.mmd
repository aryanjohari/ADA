C4Component
  title Components — Publish workflows

  Container_Boundary(publish, "Publish workflows") {
    Component(enrich, "ENRICH", "publish/enrich + workflow steps", "Gather context for the page")
    Component(gate, "GATE", "count unique HTTPS source_url facts", "Entity track only")
    Component(draft, "DRAFT", "publish/draft + PageJsonV1", "Build strict page.json")
    Component(deploy, "DEPLOY", "publish/s3_publish", "Upload page.json; merge manifest")
  }

  ComponentDb_Ext(stateDb, "state.db", "Graph facts + workflow rows")
  System_Ext(s3, "AWS S3", "Object store")

  Rel(enrich, stateDb, "Reads knowledge / graph")
  Rel(enrich, gate, "Entity: publish_entity_v1")
  Rel(enrich, draft, "Keyword: publish_keyword_v1 skips GATE")
  Rel(gate, draft, "Passes when fact threshold met")
  Rel(draft, deploy, "Validated PageJsonV1")
  Rel(deploy, s3, "/{project}/{campaign}/{slug}/page.json")
  Rel(deploy, stateDb, "Updates workflow status")
