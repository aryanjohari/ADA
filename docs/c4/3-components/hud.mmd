C4Component
  title Components — ada hud

  Container_Boundary(hud, "ada hud (Streamlit)") {
    Component(app, "Operator app", "observability/app.py", "Sidebar + tabs; not the agent")
    Component(dbRo, "RO SQLite", "observability/db_ro.py", "file:…?mode=ro connections")
    Component(whitelist, "Argv whitelist", "operator_whitelist.py", "Closed set of ada CLI actions")
    Component(subprocess, "Whitelisted subprocess", "operator_subprocess.py", "Runs only allowlisted argv")
    Component(sqlGuard, "SQL guard", "sql_guard.py", "Blocks non-SELECT operator queries")
  }

  ComponentDb_Ext(stateDb, "state.db", "Same profile DB as agent")

  Rel(app, dbRo, "Dashboard reads")
  Rel(dbRo, stateDb, "SELECT-only URI")
  Rel(app, whitelist, "Maps UI actions to command ids")
  Rel(whitelist, subprocess, "Builds argv")
  Rel(app, sqlGuard, "Ad-hoc query panel")
