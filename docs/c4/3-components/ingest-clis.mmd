C4Component
  title Components — Ingest CLIs

  Container_Boundary(ingest, "Ingest CLIs") {
    Component(rss, "RSS / Atom", "ingest/rss.py", "httpx + feedparser → knowledge_items")
    Component(brand, "Brand site", "ingest/brand.py", "HTTP pull of operator brand URLs")
    Component(gsc, "Search Console", "ingest/gsc_*.py", "Google Search Console API")
    Component(gets, "NZ GETS", "ingest/gets.py", "Polls public GETS index HTML")
    Component(kw, "Keywords", "ingest/keywords.py", "DataForSEO search volume")
    Component(gateScore, "Feed gate", "ingest/gate.py", "Scores RSS entries before insert")
  }

  ComponentDb_Ext(stateDb, "state.db", "knowledge_sources / knowledge_items")
  System_Ext(extSources, "External sources", "Feeds, GSC, GETS, DataForSEO")

  Rel(rss, gateScore, "Score entry")
  Rel(rss, stateDb, "Insert / dedupe items")
  Rel(brand, stateDb, "Writes knowledge_items")
  Rel(gsc, stateDb, "Writes analytics rows / items")
  Rel(gets, stateDb, "Writes knowledge_items")
  Rel(kw, stateDb, "Writes keyword rows")
  Rel(rss, extSources, "Fetches feeds")
  Rel(brand, extSources, "Fetches brand URLs")
  Rel(gsc, extSources, "GSC API")
  Rel(gets, extSources, "GETS HTML")
  Rel(kw, extSources, "DataForSEO API")
