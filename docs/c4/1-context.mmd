  title System Context — ADA

  Person(operator, "Operator", "Runs ADA on their own hardware (e.g. Pi)")

  System(ada, "ADA", "Local Python agent: chat, daemon, ingest, publish")

  System_Ext(gemini, "Google Gemini", "LLM turns via google-genai SDK")
