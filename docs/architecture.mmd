%% Sync’d overview alias of docs/c4/2-containers.mmd — C4 is canonical.
%% Prefer docs/c4/ for Context → Containers → Components zoom.
flowchart TB
  subgraph inputs [Inputs]
    cliChat["ada chat"]
    hostScheduler["cron / systemd"]
    hud["ada hud"]
  end

  subgraph core [Core]
    orchestrator["Orchestrator\nmanual Gemini tools"]
    toolExecutor["Tool executor\nallowlist + skills"]
    daemon["ada daemon\ngoals + workflows"]
    stateDb[("state.db\nSQLite WAL + FTS5")]
    memoryFiles[("memory/*.md")]
    ingestClis["Ingest CLIs\nRSS / GSC / brand / GETS / keywords"]
    graphLite["Graph-lite\ntriage + edges"]
    publishWorkflows["Publish workflows\nENRICH → GATE? → DRAFT → DEPLOY"]
  end

  subgraph outputs [Outputs]
    s3Out["S3 page.json + manifest\nISR consumer out of repo"]
  end

  cliChat -->|runs turns| orchestrator
  orchestrator -->|invokes tools| toolExecutor
  toolExecutor -->|persists rows| stateDb
  orchestrator -->|reads memory| memoryFiles
  orchestrator -->|transcript| stateDb

  hostScheduler -.->|runs ingest| ingestClis
  hostScheduler -.->|runs graph| graphLite
  hostScheduler -.->|supervises| daemon
  ingestClis -.->|knowledge_items| stateDb
  graphLite -.->|entities / edges| stateDb

  daemon -.->|goal turns| orchestrator
  daemon -->|advances steps| publishWorkflows
  stateDb -->|facts + workflow state| publishWorkflows
  publishWorkflows -->|DEPLOY| s3Out

  hud -.->|SELECT-only| stateDb
